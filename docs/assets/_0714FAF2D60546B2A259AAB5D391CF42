<?xml version='1.0' encoding='windows-1252' ?>
<glossarydata>
 <entry name="3-2-1 Transformation" value="The command 3-2-1 allows the user to construct transformation from a plane, line,and point." />
 <entry name="Activate for Scanning" value="If Activate for Scanning command is enabled all new scans and captured data will pass  through the activated transformation, their co-ordinates will not be in the global  space." />
 <entry name="Align Entities" value="Align Entities command uses best fit algorithm to move one entity in space so toget maximum overlapping of the reference entity and entity moved." />
 <entry name="Align to Plane" value="Align View command aligns view direction orthogonal to the selected datum plane orplane reducible datum entity (cylinder, circle, cone, slots)." />
 <entry name="Align View" value="Align View command aligns view direction orthogonal to the datum plane." />
 <entry name="Annotation" value="Short note inserted to an inspection page in Inspection mode" />
 <entry name="Apply" value="The command Apply launches the Transformation Apply mode." />
 <entry name="Apply Reverse" value="Apply Reverse command transforms visible selected entities by applying the reversedtransformation matrix." />
 <entry name="Apply to Selection" value="Apply to Selection command transforms visible selected entities from the global co-ordinatesystem to the co-ordinate system defined by the marked transformation." />
 <entry name="Area 2D Sampling" value="Area Sampling command samples the visible selected scan data patch by patch. It works on entire entity, no matter if the scans are selected wholly or partially" />
 <entry name="Auto Extract Circle" value="Auto Extract Circle command fits and creates datum circles to the visible mesh selections." />
 <entry name="Auto Extract Cone" value="Auto Extract Cone command fits and creates datum cones to the visible mesh selections." />
 <entry name="Auto Extract Cylinder" value="Auto Extract Cylinder command fits and creates datum cylinders to the visible meshselections." />
 <entry name="Auto Extract Plane" value="Auto Extract Plane command fits and creates datum planes to the visible mesh selections." />
 <entry name="Auto Extract Rectangular Slot" value="Auto Extract Rectangular Slot command fits and creates datum rectangular slots tothe visible mesh selections." />
 <entry name="Auto Extract Round Slot" value="Auto Extract Round Slot command fits and creates datum round slots to the visiblemesh selections." />
 <entry name="Auto Extract Sphere" value="Auto Extract Sphere command fits and creates datum spheres to the visible mesh selections." />
 <entry name="Average Noise Reduction" value="Average Noise Reduction command reduces noise in the visible selected data byapplying an average (Laplacian) filter." />
 <entry name="Back" value="Call Back command to set the viewport orthogonal to OXY plane from -Z side." />
 <entry name="Back to World CS" value="Back to World CS command restores the World CS as current CS and applies all non-lockedentities to it." />
 <entry name="Batch" value="Batch command carries out a series of mesh functions automatically." />
 <entry name="Bind Views" value="When enabled Bind Views - Absolute will cause all open windows to display the same visible region and to update all views simultaneously according to the active window." />
 <entry name="Cap" value="Cap command caps selected mesh holes." />
 <entry name="Chordal Tolerancing" value="Chordal Tolerancing command is the process of following a line and representing itby a polyline with the minimum number of points that will not deviate from the originalline by more than the defined error tolerance." />
 <entry name="Clear" value="Clear command restores the World CS as current CS without applying the non-lockedentities to it" />
 <entry name="Combine" value="The command Combine is used to join two transformation matrices in a single one." />
 <entry name="Combine Selected Entities" value="Combine Selected Entities command combines all visible selected entities of one typeinto single entity of the same type." />
 <entry name="Copy" value="Copy command copies the visible selection and places it in the clipboard." />
 <entry name="Copy as Transformation" value="Copy as Transformation command creates a copy of Current CS in Transformations group." />
 <entry name="Create from Probe Points" value="Create From Probe Points command creates a polyline from a sequence of visible selectedprobe points." />
 <entry name="Create New Entity from Selection" value="Create New Entity From Selection removes the visible selection and generates a copyof it as separate entity." />
 <entry name="Create Polyline (Manual)" value="Create Polyline (Manual) command allows you to create a new polyline by manuallyselecting points on the visible data." />
 <entry name="Create Viewport Entity" value="This command creates an entity, which stores the current viewport orientation." />
 <entry name="Cut" value="Cut command deletes the visible selection and places it in the clipboard." />
 <entry name="Cut (Polygonal Area)" value="Cut (Polygonal Area) command deletes selected mesh triangles that fall into a drawnpolygon or selected plane and generates a new hidden mesh entity from them." />
 <entry name="Deactivate" value="This command cancels the scanning and capturing through active transformation." />
 <entry name="Define XY Grid" value="Define XY Grid command generates point cloud from mesh or scan data selection." />
 <entry name="Delete" value="Delete command deletes the visible selection." />
 <entry name="Delete All Dimensions" value="This command deletes all dimensions in the scene no matter if their entities arevisible or hidden." />
 <entry name="Delete All Gap and Flush" value="This command deletes all Gap and FLush dimensions in the scene no matter if theirentities are visible or hidden." />
 <entry name="Delete All Labels" value="This command deletes all labels in the scene no matter if their entities are visibleor hidden." />
 <entry name="Delete Dimension" value="This command deletes the current dimension." />
 <entry name="Delete Gap and Flush" value="This command deletes the current Gap and Flush dimension." />
 <entry name="Delete Label" value="This command deletes the current labels." />
 <entry name="Delete Selected" value="Delete Selected command deletes marked entities/groups that are selected wholly orpartially." />
 <entry name="Dimensioning" value="This command switches the mode for creating and editing dimensions." />
 <entry name="Display Boundaries" value="This command affects the visual representation of all meshes in the scene. When thisoption is activated, KUBE draws mesh boundaries as connected lines." />
 <entry name="Display Grid" value="Call Display Grid to show grid lines in views that are orthogonal to the global co-ordinatesystem." />
 <entry name="Display Intensity" value="Display Intensity displays the Intensity view for ModelMaker D sensor." />
 <entry name="Display Laser Button" value="Display Laser Button hides/shows the button for switching the laser on and off." />
 <entry name="Display Localiser Position" value="Display Localiser Position hides/shows the Localiser Position window." />
 <entry name="Display Normals" value="Call Display Normals to show objects’ point normals as short yellow lines." />
 <entry name="Display Sensor" value="Display Sensor hides/shows the sensor view window, which is located in Scan Panebelow the localiser driven menu and localiser position window." />
 <entry name="Display Toolbar" value="Enable/disable Toolbar option to show/hide the main toolbar in the KUBE application." />
 <entry name="Display WorkSpace" value="Display WorkSpace command hides/shows the workspace window that contain Entitiespane, and Output pane." />
 <entry name="Down" value="Call Down command to set the viewport orthogonal to OXZ plane from -Y side." />
 <entry name="Draw First Point" value="Draw First Point is available for polylines only. If you enable it, the first nodeof every polyline will be visualised as yellow filled square." />
 <entry name="Draw Polyline Nodes as Crosses" value="When you select Draw Polyline Nodes as Crosses,all nodes of every polyline will be visualised as yellow crosses oriented to thepolyline direction." />
 <entry name="Draw Polyline Nodes as None" value="raw Polyline Nodes as None is available for polylines only. When you select it, nonodes will be displayed." />
 <entry name="Draw Polyline Nodes as Points" value="Draw Polyline Nodes as Points is available for polylines only. When you select it,all nodes of every polyline will be visualised as small yellow points." />
 <entry name="Draw Polyline Nodes as Squares" value="Draw Polyline Nodes as Squares is available for polylines only. When you select it,all nodes of every polyline will be visualised as outlined yellow squares orientedto the polyline direction." />
 <entry name="Enable Undo" value="Enable Undo command switches On/Off the Undo command." />
 <entry name="Enhance Features" value="Enhance Features command detects edges of the visible mesh selection and sharpenthem by pulling vertices towards the feature lines. You have three levels of controlhow strong the sharpness to be." />
 <entry name="Exit" value="Exits the KUBE. If there are opened and unsaved files, you will be asked whetherto save them or not." />
 <entry name="Export" value="The Export command converts data from the current document to different file formats." />
 <entry name="Extract from Boundaries" value="Extract From Boundaries command creates a polylines from visible selected mesh boundaries." />
 <entry name="Fetch" value="The Fetch command restores a previous state of data in the scene. It works as &quot;multiplesteps&quot; Undo command, but performed at once. The command is grayed when there is nosaved file state. You cannot Fetch File operations and operations in Inspection mode." />
 <entry name="Fill" value="Fill command reconstructs missing data (holes) in selected areas of the mesh." />
 <entry name="Fit Circle" value="Fit Circle command fits a datum circle to the visible selection, which may includescan data, meshes, point clouds, datum points and polylines." />
 <entry name="Fit Cone" value="Fit Cone command fits a datum cone to the visible selection, which may include scandata, meshes, point clouds, datum points and polylines." />
 <entry name="Fit Cylinder" value="Fit Cylinder command fits a datum cylinder to the visible selection, which may includescan data, meshes, point clouds, datum points and polylines." />
 <entry name="Fit Line" value="Fit Line command fits a datum line to the visible selection, which may include scandata, meshes, point clouds, datum points and polylines." />
 <entry name="Fit Multiple Lines" value="Fit Multiple Lines command fits a line through each stripe in the visible selectedscan data and calculates statistics." />
 <entry name="Fit Parallel Planes" value="Fit Parallel Planes (Manual) command fits a plane to the visible selection and asecond plane to all the visible unselected data." />
 <entry name="Fit Plane" value="Fit Plane command fits a datum plane to the visible selection, which may includescan data, meshes, point clouds, datum points and polylines." />
 <entry name="Fit Point" value="Fit Point command fits a datum point to the visible selection, which may includescan data, meshes, point clouds, datum points and polylines." />
 <entry name="Fit Sphere" value="Fit Sphere command fits a datum sphere to the visible selection, which may includescan data, meshes, point clouds, datum points and polylines." />
 <entry name="Flip Normals" value="Flip Normals command inverts the normals of all selected and visible polygons. Thismeans that if an object is ‘convex’, after the operation it will be ‘concave’, andvice versa." />
 <entry name="Format (Label)" value="This command formats individual label." />
 <entry name="From 3 Entities" value="The command From 3 Entities allows the user to create interactively transformationmatrices using different definition methods." />
 <entry name="From N Constrained Points" value="This command is used to set up transformation by more than 3 correspondences or when no exact entity match is present and needed to set correspondencesby some of the co-ordinates only." />
 <entry name="From N Points" value="Transformation From N Points command creates a transformation constructed from aset of known points." />
 <entry name="From Single Plane" value="The command From Single Plane allows the user to establish correspondence betweenan existing datum plane and one of the co-ordinate system planes." />
 <entry name="From Viewport" value="The command From Viewport allows the user to define correspondence between the realposition and the viewport position of an object in the scene." />
 <entry name="Front" value="Call Front command to set the viewport orthogonal to OXY plane from +Z side." />
 <entry name="Front-Facing Mode Selection" value="When this mode is enabled, all shape selections will select only the scan data andmesh triangles, which normals face front towards the viewport." />
 <entry name="Gap and Flush" value="This command switches the mode for creating Gap and Flush dimensions." />
 <entry name="Hide All" value="Hide All hides marked entities and groups." />
 <entry name="Hide Selection and Hide Selected" value="Hide Selection hides all entities in the scene (or those parts of them) that areselected." />
 <entry name="History" value="The command History is used to manage the applied transformations to the currentCS." />
 <entry name="Hold" value="The Hold command saves the current state of the scene in a temporary file with .hff(Hold Fetch File) extension in the user's temporary folder" />
 <entry name="Import Transformation" value="Import Transformation allows you to import co-ordinate systems from other software." />
 <entry name="Import XY Grid" value="Import XY Grid command imports point cloud from *.txt, *asc, or *.csv file formats." />
 <entry name="Instant Editing" value="Instant Editing command applies different processing tools on meshes to areas definedin the dialog." />
 <entry name="Interactive Cross Sections" value="Interactive Cross Section command produces single polylines using a line definedinteractively using the mouse and the current view." />
 <entry name="Interactive Noise Reduction by Curvature" value="Interactive Noise Reduction By Curvature command modifies the visible selection basedon the local surrounding data and local curvature." />
 <entry name="Interactive Transformation" value="The command Interactive allows the user to create interactively transformation matricesusing different definition methods." />
 <entry name="Inverse" value="Inverse command inverses the transformation matrix of a transformation." />
 <entry name="Invert Normals" value="Invert Normals command flips the normals of a scan entity." />
 <entry name="Invert Selection" value="Invert Selection selects all visible unselected entities (or parts of them) and deselectsall visible selected entities (or parts of them)." />
 <entry name="Isometric" value="Call Isometric command to set the viewport from 45 degrees on all three axes: +X,+Y, and -Z." />
 <entry name="Join" value="Join command merges two visible polylines into a single one by connecting the endpoints of both polylines." />
 <entry name="Labeling" value="This command switches the mode for creating and editing labels for datums and pointsof compound entities." />
 <entry name="Left" value="Call Left command to set the viewport orthogonal to OYZ plane from -X side." />
 <entry name="Light Adjust" value="Light Adjust allows user to change the light direction in the scene." />
 <entry name="Light Reset" value="Default light direction can be restored using Light Reset command." />
 <entry name="Linear [1D] Sampling" value="Linear Sampling command modifies the visible selected scan data by re-sampling thestripes at a specified interval." />
 <entry name="Lock in Space" value="Lock in Space command locks single or multiple entities or groups so that they won'tbe affected when updating the Current CS." />
 <entry name="Macro SpeedBar" value="Show Macro SpeedBar command displays or hides the Macro SpeedBar dialog." />
 <entry name="Material Colour" value="Material Colour command is used for changing colours of the objects and is availablefor all entities and groups that have visual representation in the scene." />
 <entry name="Material Reset" value="Material Reset command is used for setting the default colours of the objects andis available for all entities and groups that have visual representation in the scene." />
 <entry name="Median Noise Reduction" value="Median Noise Reduction command reduces noise by applying a median filter on eachstripe or visible selected polylines." />
 <entry name="Merge" value="Merge command creates a single polygon mesh from visible and selected scan data andmesh entities." />
 <entry name="Modify (Current CS)" value="Modify (Current CS) command translates and rotates the current CS." />
 <entry name="Modify (Dimension)" value="This command formats individual dimension." />
 <entry name="Modify (Transformation)" value="Modify command translates and rotates a transformation." />
 <entry name="Modify Radius" value="Modify Radius command increases/decreases radius of a datum sphere or circle." />
 <entry name="New" value="New is a standard Windows command to create new file." />
 <entry name="New Circle" value="New Circle command creates new datum circle." />
 <entry name="New Cone" value="New Cone command creates new datum cone." />
 <entry name="New Cylinder" value="New Cylinder command creates new datum cylinder." />
 <entry name="New Line" value="New Line command creates new datum line." />
 <entry name="New Plane" value="New Plane command creates new datum plane." />
 <entry name="New Point" value="New Point command creates new datum point." />
 <entry name="New Rectangular Slot" value="New Rectangular Slot command creates new datum rectangular slot." />
 <entry name="New Round Slot" value="New Round Slot command creates new datum round slot." />
 <entry name="New Sphere" value="New Sphere command creates new datum sphere." />
 <entry name="Next CS" value="Next CS command activates the next transformation in the history stack as currentCS." />
 <entry name="Noise Reduction by Curvature" value="Noise Reduction By Curvature command modifies the visible selection based on thelocal surrounding data and local curvature." />
 <entry name="Offset" value="Offset command translates a datum plane along its normal." />
 <entry name="Offset Points" value="Offset Points command is applied to scan data and meshes only." />
 <entry name="On Rotate/Pan Display ..." value="On Rotate/Pan Display... command affects visualisation of scan data, meshes,and point clouds in the scene during rotate, pan, and zoom actions and is related to the details of objects." />
 <entry name="On Rotate/Pan Draw ..." value="On Rotate/Pan Draw... command affects visualisation of scan data and meshes in  the scene during rotate, pan, and zoom actions and is related to the appearance of  objects." />
 <entry name="Open" value="Open is a standard Windows command to open an existing file." />
 <entry name="Open in Current Document" value="Open in current document is same as the Open command with one difference - it loadsthe file it in a currently active document." />
 <entry name="Optimise Meshes" value="Optimise Meshes command reduces the noise in mesh data by aligning patches." />
 <entry name="Optimise Scan" value="Optimise Scan command reduces the noise in scan data by aligning patches." />
 <entry name="Pan" value="When this mode is enabled, hold down the left mouse button and move the mouse onscreen. This will translate the viewport left, right, up, and down." />
 <entry name="Parallel Cross Sections" value="Parallel Cross Sections command creates a number of parallel cross sections throughthe visible selection." />
 <entry name="Paste As New Entity" value="Paste As New Entity command moves the data from the clipboard into the active document." />
 <entry name="PC Diagnostics" value="The PC Diagnostics command is destined to check the specification of your PC againstthe requirements of KUBE." />
 <entry name="Pick Feature Points" value="Pick Feature Points command activates capturing of feature points, which is the firststep of the registration process." />
 <entry name="Pick Pair of Planes" value="The function Pick Pair of Planes is used to measure the on-screen distances and anglebetween planes." />
 <entry name="Pick Pair of Points" value="The function Pick Pair of Points is used to measure the on-screen distances betweenpoints." />
 <entry name="Pick Selection" value="When Pick Selection mode is selected, press on the toolbar button to activate it." />
 <entry name="Pick Single Point" value="This command returns information about the currently picked point on a visible entity." />
 <entry name="Play" value="Play command displays an animated rotated view of the visible entities in the currentdocument." />
 <entry name="Point Curvature" value="Point curvature is a property of the mesh entities. The curvature at a given pointis determined by finding the greatest angle between the normals of the current vertexand the vertices from the chosen neighbourhood level" />
 <entry name="Polygon Reduction" value="Polygon Reduction command reduces points in the visible selected meshes." />
 <entry name="Preferences" value="Call the command Preferences to change different KUBE settings." />
 <entry name="Previous CS" value="Previous CS command activates the previous transformation in the history stack ascurrent CS." />
 <entry name="Properties" value="Properties command calls the properties dialog for an entity, group or root." />
 <entry name="Put Label" value="This command automatically creates label for each marked datum entity." />
 <entry name="Radial Cross Sections" value="Radial Cross Sections command creates a number of radial cross sections through thevisible selection." />
 <entry name="Register" value="Register command aligns two different surfaces in such a way so their common areascoincide. It works with scan data. mesh and point clouds entities." />
 <entry name="Remove Duplicate Triangles" value="Remove Duplicate Triangles command finds any visible selected triangles that haveidentical vertices in the mesh and removes the surplus triangles even if the directionsof their normals are opposite." />
 <entry name="Remove Faulty Areas" value="Remove Faulty Areas command removes visible selected triangles, which distort theimage." />
 <entry name="Remove Floating Meshes" value="Remove Floating Meshes command removes regions of the visible selected object, whichare isolated from the main mesh." />
 <entry name="Remove Label" value="This command automatically removes label from each marked datum entity." />
 <entry name="Rename" value="Rename command renames single entity or group." />
 <entry name="Rendering Mode" value="These context menu commands affect visual representation of scan data and meshes only." />
 <entry name="Reorganise" value="Reorganise command rearranges edges of the visible selections to follow detectionfeature lines (e.g. corners)." />
 <entry name="Repair" value="Repair command is a combination of two functions: Remove Faulty Areas and Fill afterwardsusing their default parameters." />
 <entry name="Reset Software Settings" value="Reset Software Settings command rolls back all settings to their initial values" />
 <entry name="Reverse" value="Reverse command reverses the direction of a datum line or the cylinder axe. Reverse command reverses direction of the normal of a datum plane or datum circle." />
 <entry name="Reverse Order" value="Reverse Order command reverses the direction of the visible selected polylines." />
 <entry name="Right" value="Call Right command to set the viewport orthogonal to OYZ plane from +X side." />
 <entry name="Rotate" value="When this mode is enabled and you hold down the left mouse button on the viewable  area, a dashed circle will appear. If mouse pointer is within this circle, the viewpoint  rotation is on all three axes; otherwise it is clockwise or counter-clockwise towards  the viewport." />
 <entry name="Rotate and Translate" value="Rotate and Translate command offers possibility for manual adjustment of entity position." />
 <entry name="Rotate Viewport" value="Using Rotate Viewport an object can be rotated by an exact entry of degree arounda specified axis." />
 <entry name="Sample Every" value="Sample Every command samples the visible selected polylines at the given spacing." />
 <entry name="Save (As)" value="Save is a standard Windows command to save the current file." />
 <entry name="Scale Points" value="Scale Points is applied to scan data, meshes, point clouds, probe points, and polylines.It scales the selection in X, Y, and/or Z directions of the local co-ordinate system." />
 <entry name="Select" value="Select command selects marked entities/groups." />
 <entry name="Select All" value="Select All command selects all visible entities in the scene, no matter if thereare some wholly or partially selected entities." />
 <entry name="Select Boundaries" value="Select Boundaries command selects boundary triangles of visible scans and meshes." />
 <entry name="Select Box" value="Select Box command selects these visible points that are located in a specific boxdefined by minimum and maximum co-ordinates in X, Y, and Z." />
 <entry name="Select by Curvature" value="Select By Curvature computes the curvature per visible point comparing it's normaland it's neighbour's normal, decides whether it is a curved or a flat surface andselects it." />
 <entry name="Select by Point Normal" value="Select By Point Normal selects part of a visible scan based on the angle atwhich the points were scanned." />
 <entry name="Select by Type" value="Select By Type command selects all visible entities of the chosen type." />
 <entry name="Select None" value="Select None command unselects all visible entities in the scene, no matter if thereare some wholly or partially unselected entities." />
 <entry name="Select Polylines by Number of Nodes" value="Select Polylines by Number of Nodes command selects all visible polylines in thescene, which number of vertices (nodes) is less than the value set in the dialog." />
 <entry name="Select Reverse Scans" value="Select Reverse Scans selects parts of a visible scan captured while scanningin reverse direction." />
 <entry name="Select Thin Triangles" value="Select Thin Triangles command selects areas of visible scans and meshes containing  triangles having an angle smaller than the given value." />
 <entry name="Select Triangles Based on Edge Length" value="Select Triangles Based On Edge Length command selects visible triangles based onthe length of their sides." />
 <entry name="Select Triangles Based on Order" value="Select Triangles Based on Order command selects part of a visible scan based on theorder in which the points were captured." />
 <entry name="Selection (Polygonal, Free hand, Elliptic, Rectangular)" value="The selection will consist of all visible points and whole visible entities thatare inside." />
 <entry name="Set to Current View" value="This command changes the viewport orientation to the current one." />
 <entry name="Show All" value="Show All command displays all hidden entities (or those parts of them that are hidden.)" />
 <entry name="Smooth Boundaries" value="Smooth Boundaries command smoothes boundaries of the visible selections by creatingmore triangles." />
 <entry name="Snapshot" value="Snapshot captures the whole viewport." />
 <entry name="Sort by Name" value="Sort by Name command sorts all datum entities in the Datuming group by name." />
 <entry name="Sort by Type" value="Sort by Type command sorts all datum entities in the Datuming group by type." />
 <entry name="Sort Polylines" value="Sort Polylines command re-orders visible selected polylines so that their order reflectstheir position in space rather than the sequence in which they were created." />
 <entry name="Split Mesh" value="The Split Mesh command divides the whole mesh entity to sub-meshes and creates Nnew mesh items in the entity tree." />
 <entry name="Split Scan Data" value="Split Scan Data command splits visible selected (wholly or partially) scan data entitiesinto entities containing single patches." />
 <entry name="Static View" value="Static View command affects visualisation of scan data (all rendering modes) andmeshes (when in Points or Large Points mode only) in a static scene and is relatedto the details of objects." />
 <entry name="Stitch" value="Stitch command attempts to fill the visible selected gaps in the mesh, by joiningthe boundaries of long thin holes." />
 <entry name="Subdivide" value="Subdivide command subdivides larger triangles within the visible selected area intosmaller ones." />
 <entry name="Toggle Wireframe" value="These command toggles the current shading mode (Flat or Smooth) with shading + wireframemode (Flat + Wireframe or Smooth + Wireframe) and vice versa." />
 <entry name="Trim Patches" value="Trim Patches command removes the overlapping points on scan data patches at givenoverlapping distance. It works on entire entity, no matter if the scans are selectedwholly or partially." />
 <entry name="Type In Transformation" value="Type-In Transformation command is used to directly set rotation/translation valuesor the transformation matrix." />
 <entry name="Undo" value="Undo command restores the previous state of data in the scene. It works one stepback only." />
 <entry name="Unify Normals" value="Unify Normals command unifies all the polygon normals in the visible selected mesh." />
 <entry name="Unify Normals Interactive" value="Unify Normals Interactive command detects a ‘submesh’ and inverts the normals whenclicking on a triangle with reverse normal ." />
 <entry name="Unlock" value="Unlock command unlocks single or multiple entities or groups so that they will beaffected when updating the current CS." />
 <entry name="Unselect All" value="Unselect All command unselects marked entities/groups that are selected (or partiallyselected)." />
 <entry name="Up" value="Call Up command to set the viewport orthogonal to OXZ plane from +Y side." />
 <entry name="Update Current CS" value="Update Current command updates the current co-ordinate system with the selected transformation." />
 <entry name="Use View Position" value="This command applies a custom view position to the scene." />
 <entry name="Volume [3D] Sampling" value="Volume Sampling command fits a cubic grid to the visible selected mesh/scan data extents." />
 <entry name="Weld" value="Weld command removes surplus triangles." />
 <entry name="Zoom All" value="Zoom All command resets the view extents to fit all visible data." />
 <entry name="Zoom In" value="Zoom In command magnifies all visible data twice." />
 <entry name="Zoom Mode" value="When this mode is enabled, hold down the left mouse button and move the mouse upor down to zoom in or out." />
 <entry name="Zoom Out" value="Zoom Out command recedes all visible data twice." />
 <entry name="Zoom Selected" value="Zoom Selected command resets the view extents to fit all visible selected data." />
 <entry name="Zoom Window" value="When this mode is enabled, hold down the left mouse button and drag the mouse todraw a rectangle. After releasing the button KUBE resets the view extents to fit the visible data inthat rectangle." />

</glossarydata>
