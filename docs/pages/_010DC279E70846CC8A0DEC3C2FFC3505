<tr valign="top" class="whs15">
<td width="17.233%" class="whs19">
<p class="normal-table-func"><span class="Command">Select All</span></p>
</td>
<td width="73.392%" class="whs20">
<p class="normal-table">Selects marked entities/groups.</p>
</td>
<td width="9.375%" class="whs21">
<p class="normal-table"><a href="../References/Select.htm"><img src="../Corrosion/Images/i_blue_sm.jpg" width="23px" height="16px" border="0" class="img_whs22" alt=""></a></p>
</td>
