<tr valign="top" class="whs23">
<td width="16.893%" class="whs27">
<p class="normal-table-func"><span class="Command">Export</span></p>
</td>
<td width="74.599%" class="whs28">
<p class="normal-table">Converts data from the current document to different file formats. This command work with whole or partially selected entities.</p>
</td>
<td width="4.125%" class="whs29">
<p class="normal-table"><a href="../References/export.htm"><img src="../Corrosion/Images/i_blue_sm.jpg" width="23px" height="16px" border="0" class="img_whs30" alt=""></a></p>
</td>
</tr>
</table>
