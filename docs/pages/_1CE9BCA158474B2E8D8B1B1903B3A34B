<td colspan="1" rowspan="1" bgcolor="#EAE8D6" width="17.029%" class="whs25">
<p align="center" class="whs38">Command</p>
</td>
<td colspan="1" rowspan="1" bgcolor="#EAE8D6" width="73.596%" class="whs26">
<p align="center" class="whs38">Description</p>
</td>
<td colspan="1" rowspan="1" bgcolor="#EAE8D6" width="9.375%" class="whs27">
<p align="center" class="whs38">Details</p>
