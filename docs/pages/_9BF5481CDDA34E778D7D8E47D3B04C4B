<col>
<tr valign="top" class="whs6">
<td class="whs7">
<p class="Normal"><span lang="EN-GB">View from which the cutting planes are defined</span></p>
<p class="Normal" style="text-align:justify;"><span lang="EN-GB"><img src="processing_polylines_files/image032.jpg" width="507px" height="357px" border="0" class="img_whs8" alt=""></span></p>
<p class="Normal" style="text-align:justify;"><span lang="EN-GB">View changed</span></p>
<p class="Normal" style="text-align:justify;"><span lang="EN-GB"><img src="processing_polylines_files/image034.jpg" width="509px" height="359px" border="0" class="img_whs9" alt=""></span></p>
</td>
