<tr valign="top" class="whs6">
<td class="whs10">
<p align="center" class="whs11"><span lang="EN-GB">Mesh before Enhance Features applied</span></p>
</td>
<td class="whs12">
<p align="center" class="whs11"><span lang="EN-GB">Mesh after Enhance Features applied to the edge</span></p>
</td>
</tr>
