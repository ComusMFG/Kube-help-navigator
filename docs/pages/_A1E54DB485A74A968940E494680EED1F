<p class="normal-table"><img src="Images/image001.gif" width="300px" height="308px" border="0" class="img_whs9" alt=""></p>
</td>
<td width="405px" class="whs10">
<p class="normal-table">&#160;</p>
<table cellspacing="0" width="100%" class="whs11">
<col class="whs12">
<tr valign="top" class="whs13">
<td valign="middle" width="100%" class="whs14">
<p class="normal-table"><a href="#Final">Final Operations' group</a></p>
</td>
</tr>
